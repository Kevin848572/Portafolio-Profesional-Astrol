---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import AdminSidebar from '../../components/admin/AdminSidebar.astro';
import AdminNavbar from '../../components/admin/AdminNavbar.astro';
---

<AdminLayout title="Perfil">
  <AdminSidebar />
  <AdminNavbar title="Editar Perfil" />

  <main class="ml-[var(--sidebar-width)] pt-20 px-8 pb-12 min-h-screen transition-all duration-300">
    <p class="text-sm mb-6" style="color: var(--textMuted);">Actualiza tu información personal y redes sociales &bull; Documento Firebase: <span class="font-mono text-cyan-400">profile/main</span></p>

    <form id="profile-form" class="max-w-2xl space-y-6">
      <!-- Basic Info -->
      <div class="admin-card p-6">
        <h3 class="font-bold mb-4" style="color: var(--textMain);">Información Básica</h3>
        <div class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">Nombre *</label>
              <input type="text" id="pr-name" class="admin-input" required />
            </div>
            <div>
              <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">Rol *</label>
              <input type="text" id="pr-role" class="admin-input" required />
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">Estado</label>
            <input type="text" id="pr-status" class="admin-input" />
          </div>
          <div>
            <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">Título *</label>
            <input type="text" id="pr-title" class="admin-input" required />
          </div>
          <div>
            <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">Subtítulo *</label>
            <textarea id="pr-subtitle" class="admin-input" rows="3" required></textarea>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">Email *</label>
              <input type="email" id="pr-email" class="admin-input" required />
            </div>
            <div>
              <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">Ubicación *</label>
              <input type="text" id="pr-location" class="admin-input" required />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">URL Imagen</label>
              <input type="url" id="pr-image" class="admin-input" />
            </div>
            <div>
              <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">URL CV</label>
              <input type="url" id="pr-cv" class="admin-input" />
            </div>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="admin-card p-6">
        <h3 class="font-bold mb-4" style="color: var(--textMain);">Estadísticas</h3>
        <div id="stats-fields" class="space-y-3"></div>
        <button type="button" id="btn-add-stat" class="btn-secondary mt-3 flex items-center gap-2 text-sm">
          <span class="material-icons-outlined text-[16px]">add</span>
          Agregar estadística
        </button>
      </div>

      <!-- Socials -->
      <div class="admin-card p-6">
        <h3 class="font-bold mb-4" style="color: var(--textMain);">Redes Sociales</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">GitHub</label>
            <input type="url" id="pr-github" class="admin-input" placeholder="https://github.com/..." />
          </div>
          <div>
            <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">LinkedIn</label>
            <input type="url" id="pr-linkedin" class="admin-input" placeholder="https://linkedin.com/in/..." />
          </div>
          <div>
            <label class="block text-xs font-semibold mb-1.5 uppercase tracking-wider" style="color: var(--textMuted);">Instagram</label>
            <input type="url" id="pr-instagram" class="admin-input" placeholder="https://instagram.com/..." />
          </div>
        </div>
      </div>

      <div id="profile-error" class="hidden text-sm font-medium px-4 py-3 rounded-xl"
        style="background: rgba(239, 68, 68, 0.1); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.2);"></div>
      
      <div id="profile-success" class="hidden text-sm font-medium px-4 py-3 rounded-xl"
        style="background: rgba(34, 197, 94, 0.1); color: var(--success); border: 1px solid rgba(34, 197, 94, 0.2);"></div>

      <div class="flex justify-end">
        <button type="submit" class="btn-primary flex items-center gap-2">
          <span class="material-icons-outlined text-[18px]">save</span>
          Guardar Cambios
        </button>
      </div>
    </form>
  </main>
</AdminLayout>

<script is:inline>
  const API_URL = window.PUBLIC_API_URL || '';

  let stats = [];

  function getToken() { return localStorage.getItem('admin_token'); }

  async function fetchAPI(endpoint, options = {}) {
    const token = getToken();
    const res = await fetch(`${API_URL}${endpoint}`, {
      ...options,
      headers: {
        'Content-Type': 'application/json',
        ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
        ...options.headers,
      },
    });
    if (res.status === 401) {
      localStorage.removeItem('admin_token');
      window.location.href = '/admin/login';
      return null;
    }
    return res;
  }

  function renderStats() {
    const container = document.getElementById('stats-fields');
    container.innerHTML = stats.map((s, i) => `
      <div class="flex items-center gap-3">
        <input type="text" class="admin-input stat-label" data-index="${i}" value="${s.label}" placeholder="Label" />
        <input type="text" class="admin-input stat-value" data-index="${i}" value="${s.value}" placeholder="Valor" />
        <button type="button" onclick="removeStat(${i})" class="p-2 rounded-lg hover:opacity-80 shrink-0" style="color: var(--danger);">
          <span class="material-icons-outlined text-[18px]">delete</span>
        </button>
      </div>
    `).join('');
  }

  window.removeStat = function(index) {
    stats.splice(index, 1);
    renderStats();
  };

  document.getElementById('btn-add-stat')?.addEventListener('click', () => {
    stats.push({ label: '', value: '' });
    renderStats();
  });

  async function loadProfile() {
    const res = await fetchAPI('/api/profile');
    if (!res) return;
    const p = await res.json();

    document.getElementById('pr-name').value = p.name || '';
    document.getElementById('pr-role').value = p.role || '';
    document.getElementById('pr-status').value = p.status || '';
    document.getElementById('pr-title').value = p.title || '';
    document.getElementById('pr-subtitle').value = p.subtitle || '';
    document.getElementById('pr-email').value = p.email || '';
    document.getElementById('pr-location').value = p.location || '';
    document.getElementById('pr-image').value = p.image_url || '';
    document.getElementById('pr-cv').value = p.cv_url || '';

    stats = p.stats || [];
    renderStats();

    const socials = p.socials || {};
    document.getElementById('pr-github').value = socials.github || '';
    document.getElementById('pr-linkedin').value = socials.linkedin || '';
    document.getElementById('pr-instagram').value = socials.instagram || '';
  }

  document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errorMsg = document.getElementById('profile-error');
    const successMsg = document.getElementById('profile-success');
    errorMsg.style.display = 'none';
    successMsg.style.display = 'none';

    // Collect stats from inputs
    const labels = document.querySelectorAll('.stat-label');
    const values = document.querySelectorAll('.stat-value');
    const currentStats = [];
    labels.forEach((el, i) => {
      if (el.value && values[i].value) {
        currentStats.push({ label: el.value, value: values[i].value });
      }
    });

    const body = {
      name: document.getElementById('pr-name').value,
      role: document.getElementById('pr-role').value,
      status: document.getElementById('pr-status').value,
      title: document.getElementById('pr-title').value,
      subtitle: document.getElementById('pr-subtitle').value,
      email: document.getElementById('pr-email').value,
      location: document.getElementById('pr-location').value,
      image_url: document.getElementById('pr-image').value || '/logo.png',
      cv_url: document.getElementById('pr-cv').value || '#',
      stats: currentStats,
      socials: {
        github: document.getElementById('pr-github').value || null,
        linkedin: document.getElementById('pr-linkedin').value || null,
        instagram: document.getElementById('pr-instagram').value || null,
      },
    };

    try {
      const res = await fetchAPI('/api/profile', { method: 'PUT', body: JSON.stringify(body) });
      if (res && res.ok) {
        successMsg.textContent = 'Perfil actualizado exitosamente';
        successMsg.style.display = 'block';
        setTimeout(() => { successMsg.style.display = 'none'; }, 3000);
      } else {
        const err = await res.json().catch(() => ({ detail: 'Error al guardar' }));
        errorMsg.textContent = err.detail || 'Error al guardar';
        errorMsg.style.display = 'block';
      }
    } catch (error) {
      errorMsg.textContent = 'Error de conexión';
      errorMsg.style.display = 'block';
    }
  });

  document.addEventListener('astro:page-load', () => { if (getToken()) loadProfile(); });
  loadProfile();
</script>
