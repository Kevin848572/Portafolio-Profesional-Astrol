---
const pathname = Astro.url.pathname;

const menuItems = [
  { href: '/admin', icon: 'dashboard', label: 'Dashboard' },
  { href: '/admin/mensajes', icon: 'email', label: 'Mensajes' },
  { href: '/admin/proyectos', icon: 'folder', label: 'Proyectos' },
  { href: '/admin/habilidades', icon: 'psychology', label: 'Habilidades' },
  { href: '/admin/experiencia', icon: 'work', label: 'Experiencia' },
  { href: '/admin/perfil', icon: 'person', label: 'Perfil' },
];

const isActive = (href: string) => {
  if (href === '/admin') return pathname === '/admin' || pathname === '/admin/';
  return pathname.startsWith(href);
};
---

<aside class="fixed top-0 left-0 h-screen w-[var(--sidebar-width)] z-40 flex flex-col transition-all duration-300"
  style="background: var(--card-bg); backdrop-filter: blur(24px) saturate(180%); -webkit-backdrop-filter: blur(24px) saturate(180%); border-right: 1px solid var(--card-border);">
  
  <!-- Logo y Foto de Usuario Admin -->
  <div class="px-5 py-4 flex items-center gap-3" style="border-bottom: 1px solid var(--card-border);">
    <div class="w-10 h-10 rounded-xl overflow-hidden border border-accent/40 shadow-[0_0_15px_rgba(var(--accent-rgb),0.3)] shrink-0 bg-[#0b1329] p-[1px]">
      <img src="/foto_mia.png" alt="Foto de Kevin Pérez" class="w-full h-full object-cover object-[center_18%] rounded-[9px]" />
    </div>
    <div class="overflow-hidden">
      <p class="font-bold text-sm truncate" style="color: var(--textMain);">Kevin Pérez</p>
      <p class="text-[11px] font-mono" style="color: var(--accent);">Administrador</p>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto no-scrollbar">
    {menuItems.map(item => (
      <a
        href={item.href}
        class={`flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-300 ${
          isActive(item.href) ? '' : 'hover:opacity-80'
        }`}
        style={isActive(item.href)
          ? `background: rgba(var(--accent-rgb), 0.15); color: var(--accent); border: 1px solid rgba(var(--accent-rgb), 0.3); box-shadow: 0 0 20px rgba(var(--accent-rgb), 0.15); backdrop-filter: blur(10px);`
          : `color: var(--textMuted); border: 1px solid transparent;`
        }
      >
        <span class="material-icons-outlined text-[20px]">{item.icon}</span>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <!-- Footer -->
  <div class="px-4 py-3 space-y-2.5" style="border-top: 1px solid var(--card-border);">
    <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25);">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
      <div class="min-w-0">
        <p class="font-bold text-[11px] text-emerald-400 leading-none truncate">Firebase Firestore</p>
        <p class="text-[10px] text-amber-300/80 font-mono mt-0.5 truncate">portafolio-ae314</p>
      </div>
    </div>

    <a href="/" target="_blank" class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-medium transition-all hover:opacity-80"
      style="color: var(--textMuted);">
      <span class="material-icons-outlined text-[16px]">open_in_new</span>
      Ver portafolio
    </a>
  </div>
</aside>
