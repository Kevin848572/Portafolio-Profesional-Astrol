---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="fixed top-0 right-0 z-30 h-16 flex items-center justify-between px-8 transition-all duration-300"
  style={`background: var(--navbar-bg); backdrop-filter: blur(24px) saturate(180%); -webkit-backdrop-filter: blur(24px) saturate(180%); border-bottom: 1px solid var(--card-border); left: var(--sidebar-width);`}>
  <h1 class="text-lg font-bold" style="color: var(--textMain);">{title}</h1>
  
  <div class="flex items-center gap-3">
    <!-- Usuario Admin con Foto -->
    <a href="/admin/perfil" class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl transition-all duration-300 hover:opacity-90"
      style="background: var(--card-bg); border: 1px solid var(--card-border);" title="Ver Perfil">
      <div class="w-7 h-7 rounded-full overflow-hidden border border-accent/40 shrink-0">
        <img src="/foto_mia.png" alt="Foto Admin" class="w-full h-full object-cover object-[center_18%]" />
      </div>
      <span class="text-xs font-bold hidden sm:inline" style="color: var(--textMain);">Kevin Pérez</span>
    </a>

    <button id="admin-theme-toggle" class="p-2 rounded-xl transition-all duration-300 hover:opacity-80"
      style="color: var(--textMuted); background: var(--card-bg); border: 1px solid var(--card-border); backdrop-filter: blur(10px);">
      <span class="material-icons-outlined text-[18px] dark-icon">dark_mode</span>
      <span class="material-icons-outlined text-[18px] light-icon" style="display: none;">light_mode</span>
    </button>
    
    <button id="admin-logout" class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-300 hover:opacity-80"
      style="color: var(--danger); background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25); backdrop-filter: blur(10px);">
      <span class="material-icons-outlined text-[16px]">logout</span>
      Salir
    </button>
  </div>
</header>

<script is:inline>
  function setupAdminNavbar() {
    const toggle = document.getElementById('admin-theme-toggle');
    const logout = document.getElementById('admin-logout');
    const darkIcon = toggle?.querySelector('.dark-icon');
    const lightIcon = toggle?.querySelector('.light-icon');

    const updateIcons = () => {
      const isLight = document.documentElement.classList.contains('light');
      if (darkIcon) darkIcon.style.display = isLight ? 'none' : 'block';
      if (lightIcon) lightIcon.style.display = isLight ? 'block' : 'none';
    };

    updateIcons();

    toggle?.addEventListener('click', () => {
      const isLight = document.documentElement.classList.contains('light');
      if (isLight) {
        document.documentElement.classList.remove('light');
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.classList.add('light');
        localStorage.setItem('theme', 'light');
      }
      updateIcons();
    });

    logout?.addEventListener('click', () => {
      localStorage.removeItem('admin_token');
      window.location.href = '/admin/login';
    });

    document.addEventListener('astro:page-load', updateIcons);
  }

  setupAdminNavbar();
  document.addEventListener('astro:after-swap', setupAdminNavbar);
</script>
