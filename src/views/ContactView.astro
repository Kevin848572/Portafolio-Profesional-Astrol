---
import Layout from "./layouts/Layout.astro";
import Navbar from "./components/Navbar.astro";
import { ContactController } from "../controllers/ContactController.js";
---

<Layout title="Contactar | Desarrollador Frontend">
  <Navbar />

  <main class="min-h-screen relative flex items-center justify-center p-4">
    <!-- Fondo de Pantalla Fijo con Capa Adaptativa -->
    <div class="fixed inset-0 z-0">
      <img
        src="/contact-bg.png"
        alt="Background Workspace"
        class="w-full h-full object-cover"
      />
      <!-- Capa de color adaptativa (se adapta al color de fondo en opacidad) -->
      <div class="absolute inset-0 bg-background/85 transition-colors duration-450"></div>
    </div>

    <!-- Formulario: Muy Centrado, Estilo Glassmorphism con Esquinas Redondeadas -->
    <div
      class="relative z-10 w-full max-w-[380px] p-8 md:p-10 rounded-[2.5rem] border border-cardBorder backdrop-blur-md bg-cardBg/30 shadow-[0_12px_40px_rgba(0,0,0,0.4)] flex flex-col justify-center reveal-on-scroll opacity-0 translate-y-10 transition-all duration-1000 ease-out"
    >
      <div class="text-center mb-8">
        <h2 class="text-3xl font-black uppercase tracking-[0.1em] text-textMain mb-2">
          Hablemos<span class="text-accent">.</span>
        </h2>
        <p class="text-textMuted text-xs font-light uppercase tracking-wider">Envíame un mensaje.</p>
      </div>

      <form class="flex flex-col gap-5">
        <div>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full bg-background/40 border border-cardBorder rounded-xl px-4 py-3.5 text-textMain focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all text-sm placeholder-textMuted/60"
            placeholder="Nombre Completo"
          />
        </div>

        <div>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full bg-background/40 border border-cardBorder rounded-xl px-4 py-3.5 text-textMain focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all text-sm placeholder-textMuted/60"
            placeholder="Correo Electrónico"
          />
        </div>

        <div>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="w-full bg-background/40 border border-cardBorder rounded-xl px-4 py-3.5 text-textMain focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all text-sm resize-none placeholder-textMuted/60"
            placeholder="Mensaje..."></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-accent text-background font-bold py-3.5 rounded-xl hover:bg-textMain hover:scale-[1.03] transition-all duration-300 text-sm mt-2 shadow-lg cursor-pointer"
        >
          Enviar Mensaje
        </button>
      </form>
    </div>

    <!-- Floating Star Sparkle -->
    <div class="fixed bottom-8 right-8 z-30 pointer-events-none select-none animate-pulse">
      <svg class="w-10 h-10 md:w-14 md:h-14 text-accent drop-shadow-[0_0_15px_rgba(212,175,55,0.6)]" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z" />
      </svg>
    </div>
  </main>
</Layout>

<script>
  const setupContactObserver = () => {
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.1,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-10");
          entry.target.classList.add("opacity-100", "translate-y-0");
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const elements = document.querySelectorAll(".reveal-on-scroll");
    elements.forEach((el) => observer.observe(el));
  };

  document.addEventListener("DOMContentLoaded", setupContactObserver);
</script>
