---
export interface ProjectItem {
  id: string;
  title: string;
  desc: string;
  category: string;
  tags: string[];
  image: string;
  githubUrl: string;
  demoUrl?: string;
  featured?: boolean;
}

interface Props {
  projects: ProjectItem[];
  title?: string;
  subtitle?: string;
  viewAllLink?: boolean;
}

const { 
  projects = [], 
  title = "TRABAJOS SELECCIONADOS", 
  subtitle = "Proyectos con arquitectura de alto rendimiento, interfaces reactivas y diseño de impacto.", 
  viewAllLink = true 
} = Astro.props;
---

<div class="project-showcase-3d-wrapper w-full flex flex-col gap-8">
  
  <!-- Encabezado del Showcase -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4 border-b border-cardBorder">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="text-[10px] font-mono uppercase tracking-widest text-accent font-bold">PORTFOLIO MATRIX // HIGHLIGHTS</span>
      </div>
      <h2 class="text-xl sm:text-2xl md:text-3xl font-black uppercase tracking-[0.06em] text-textMain">
        {title}
      </h2>
      <p class="text-xs sm:text-sm text-textMuted font-light mt-1">
        {subtitle}
      </p>
    </div>

    {viewAllLink && (
      <a 
        href="/proyectos" 
        class="magnetic-btn self-start sm:self-auto px-4 py-2 rounded-full border border-cardBorder bg-cardBg hover:border-accent hover:text-accent text-xs uppercase tracking-wider font-bold text-textMuted transition-all flex items-center gap-2 group shadow-sm"
      >
        <span>Ver Todos ({projects.length})</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
        </svg>
      </a>
    )}
  </div>

  <!-- Contenedor con Perspectiva 3D -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 perspective-1000">
    {projects.map((project, idx) => (
      <article 
        data-id={project.id}
        class="project-card-3d group relative rounded-3xl border border-cardBorder bg-cardBg/80 backdrop-blur-xl p-5 sm:p-7 flex flex-col justify-between min-h-[400px] overflow-hidden shadow-[0_12px_35px_rgba(0,0,0,0.4)] transition-all duration-500 hover:border-accent/40 hover:shadow-[0_20px_50px_rgba(245,158,11,0.2)] preserve-3d cursor-default"
      >
        <!-- Overlay de Brillo Dinámico (Spotlight Glow) -->
        <div class="card-glow-overlay absolute inset-0 pointer-events-none rounded-3xl transition-opacity duration-300 opacity-0 z-20"></div>

        <!-- Borde sutil de neón superior -->
        <div class="absolute top-0 left-0 right-0 h-[1.5px] bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>

        <!-- Bloque Superior: Metadata y Previsualización -->
        <div class="relative z-10 flex flex-col gap-4">
          
          <!-- Header de Tarjeta: Indice y Categoría -->
          <div class="flex items-center justify-between text-xs">
            <span class="font-mono text-[11px] font-bold text-accent tracking-widest">
              0{idx + 1} // SYS_{project.category.toUpperCase()}
            </span>
            <span class="px-2.5 py-1 rounded-full bg-background/80 border border-cardBorder text-[10px] uppercase font-mono font-semibold text-textMuted">
              {project.category}
            </span>
          </div>

          <!-- Previsualización con Zoom Suave y Escala de Grises -->
          <div class="relative h-44 sm:h-48 w-full rounded-2xl overflow-hidden border border-cardBorder/80 bg-cardBg shadow-inner">
            <img 
              src={project.image} 
              alt={project.title}
              class="card-image-preview w-full h-full object-cover filter grayscale contrast-110 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700" 
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-transparent to-transparent pointer-events-none"></div>
            
            <div class="absolute bottom-3 left-3 flex items-center gap-1.5 px-3 py-1 rounded-full bg-background/80 backdrop-blur-md border border-accent/30 text-[10px] font-mono text-accent font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
              VERIFICADO
            </div>
          </div>

          <!-- Título y Descripción -->
          <div class="flex flex-col gap-2 pt-1">
            <h3 class="text-xl sm:text-2xl font-bold text-textMain group-hover:text-accent transition-colors duration-300">
              {project.title}
            </h3>
            <p class="text-xs sm:text-sm text-textMuted font-light leading-relaxed line-clamp-2">
              {project.desc}
            </p>
          </div>
        </div>

        <!-- Bloque Inferior: Tags y Enlaces -->
        <div class="relative z-10 mt-6 flex flex-col gap-4 pt-4 border-t border-cardBorder/60">
          
          <div class="flex gap-1.5 flex-wrap">
            {project.tags.map((tag) => (
              <span class="interactive-tag text-[10px] font-semibold px-2.5 py-0.5 bg-background/70 border border-cardBorder rounded-full text-textMain/90 hover:border-accent/50 hover:text-accent transition-colors font-mono">
                {tag}
              </span>
            ))}
          </div>

          <div class="flex items-center justify-between pt-1">
            <a 
              href={project.githubUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-xs font-bold text-accent hover:underline flex items-center gap-1.5 group/link py-1"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              <span>Código Fuente</span>
              <svg class="w-3 h-3 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"></path>
              </svg>
            </a>

            <a 
              href={project.demoUrl || project.githubUrl}
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-4 py-1.5 rounded-full bg-accent/15 border border-accent/40 text-accent font-bold text-[11px] uppercase tracking-wider hover:bg-accent hover:text-background transition-all duration-300 shadow-sm"
            >
              Explorar
            </a>
          </div>
        </div>

      </article>
    ))}
  </div>

</div>
