---
interface Props {
  class?: string;
}

const { class: className = "w-full max-w-[620px]" } = Astro.props;
---

<div class={`relative flex flex-col items-center justify-center select-none text-center ${className}`}>
  
  <!-- Resplandor ambiental de fondo dinámico -->
  <div class="logo-ambient-glow absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] h-[320px] sm:w-[520px] sm:h-[520px] rounded-full pointer-events-none -z-10 animate-pulse"></div>

  <!-- 1. ICONO VECTORIAL SVG (Átomo React + Cohete Astro + Tag AWS) -->
  <div class="w-full max-w-[320px] sm:max-w-[420px] md:max-w-[460px] mx-auto transition-transform duration-500 hover:scale-[1.03]">
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      viewBox="0 0 540 310" 
      class="w-full h-auto logo-svg"
      fill="none"
      aria-label="Emblema KevinDev"
    >
      <defs>
        <!-- Filtro Neón Modo Oscuro -->
        <filter id="kd-dark-neon" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="blur1" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="7" result="blur2" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="15" result="blur3" />
          <feMerge>
            <feMergeNode in="blur3" />
            <feMergeNode in="blur2" />
            <feMergeNode in="blur1" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>

        <!-- Filtro Brillante Modo Claro (Luminoso, saturado y de alto contraste) -->
        <filter id="kd-light-neon" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="2" result="lblur1" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="lblur2" />
          <feMerge>
            <feMergeNode in="lblur2" />
            <feMergeNode in="lblur1" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <!-- Grupo Emblema Centrado -->
      <g transform="translate(270, 145)">
        
        <!-- A. ÓRBITAS DEL ÁTOMO (REACT) - TRAYECTORIAS VECTORIALES SIN RELLENO -->
        <!-- Órbita 1 (30deg) -->
        <g transform="rotate(30)">
          <ellipse cx="0" cy="0" rx="112" ry="40" class="orbit-glow" />
          <ellipse cx="0" cy="0" rx="112" ry="40" class="orbit-main" />
          <ellipse cx="0" cy="0" rx="112" ry="40" class="orbit-core" />
        </g>

        <!-- Órbita 2 (-30deg) -->
        <g transform="rotate(-30)">
          <ellipse cx="0" cy="0" rx="112" ry="40" class="orbit-glow" />
          <ellipse cx="0" cy="0" rx="112" ry="40" class="orbit-main" />
          <ellipse cx="0" cy="0" rx="112" ry="40" class="orbit-core" />
        </g>

        <!-- Órbita 3 (90deg vertical) -->
        <g transform="rotate(90)">
          <ellipse cx="0" cy="0" rx="112" ry="40" class="orbit-glow" />
          <ellipse cx="0" cy="0" rx="112" ry="40" class="orbit-main" />
          <ellipse cx="0" cy="0" rx="112" ry="40" class="orbit-core" />
        </g>

        <!-- B. NÚCLEO COHETE ASTRO (En el centro) -->
        <g transform="translate(0, -3)">
          <path d="M 0,-42 L 27,21 L 15,17 L 0,24 L -15,17 L -27,21 Z" class="icon-fill-bg" />
          
          <path d="M 0,-42 L 27,21 L 15,17 L 0,24 L -15,17 L -27,21 Z" class="orbit-glow" stroke-width="5.5" />
          <path d="M 0,-42 L 27,21 L 15,17 L 0,24 L -15,17 L -27,21 Z" class="orbit-main" stroke-width="3.4" />
          <path d="M 0,-42 L 27,21 L 15,17 L 0,24 L -15,17 L -27,21 Z" class="orbit-core" stroke-width="1.5" />

          <!-- Chevron interior de Astro -->
          <path d="M -13,0 L 0,-13 L 13,0" class="orbit-glow" stroke-width="4.5" fill="none" />
          <path d="M -13,0 L 0,-13 L 13,0" class="orbit-main" stroke-width="2.8" fill="none" />
          <path d="M -13,0 L 0,-13 L 13,0" class="orbit-core" stroke-width="1.4" fill="none" />
          
          <!-- Punto de Ignición Central -->
          <circle cx="0" cy="8" r="3.2" class="center-ignition-dot" />
        </g>

        <!-- C. AWS CODE TAG < ☁️ > (En la parte inferior derecha) -->
        <g transform="translate(70, 52)">
          <!-- Corchete Izquierdo '<' -->
          <g>
            <path d="M -24,-20 L -40,0 L -24,20" class="orbit-glow" stroke-width="5.5" fill="none" />
            <path d="M -24,-20 L -40,0 L -24,20" class="orbit-main" stroke-width="3.4" fill="none" />
            <path d="M -24,-20 L -40,0 L -24,20" class="orbit-core" stroke-width="1.5" fill="none" />
          </g>

          <!-- Nube AWS -->
          <g transform="translate(0, 0)">
            <path d="M -15,10 H 15 A 7.5,7.5 0 0,0 20,2 A 9.5,9.5 0 0,0 8,-8 A 12,12 0 0,0 -9,-6 A 8.5,8.5 0 0,0 -15,10 Z" class="icon-fill-bg" />
            
            <path d="M -15,10 H 15 A 7.5,7.5 0 0,0 20,2 A 9.5,9.5 0 0,0 8,-8 A 12,12 0 0,0 -9,-6 A 8.5,8.5 0 0,0 -15,10 Z" class="orbit-glow" stroke-width="4.8" fill="none" />
            <path d="M -15,10 H 15 A 7.5,7.5 0 0,0 20,2 A 9.5,9.5 0 0,0 8,-8 A 12,12 0 0,0 -9,-6 A 8.5,8.5 0 0,0 -15,10 Z" class="orbit-main" stroke-width="3.0" fill="none" />
            <path d="M -15,10 H 15 A 7.5,7.5 0 0,0 20,2 A 9.5,9.5 0 0,0 8,-8 A 12,12 0 0,0 -9,-6 A 8.5,8.5 0 0,0 -15,10 Z" class="orbit-core" stroke-width="1.4" fill="none" />

            <text x="0" y="5.5" text-anchor="middle" class="cloud-text">A</text>
          </g>

          <!-- Corchete Derecho '>' -->
          <g>
            <path d="M 24,-20 L 40,0 L 24,20" class="orbit-glow" stroke-width="5.5" fill="none" />
            <path d="M 24,-20 L 40,0 L 24,20" class="orbit-main" stroke-width="3.4" fill="none" />
            <path d="M 24,-20 L 40,0 L 24,20" class="orbit-core" stroke-width="1.5" fill="none" />
          </g>
        </g>

      </g>
    </svg>
  </div>

  <!-- 2. TIPOGRAFÍA PRINCIPAL KEVINDEV (HTML/CSS de Alta Definición) -->
  <div class="mt-3 sm:mt-4 flex flex-col items-center justify-center">
    <h1 class="brand-title tracking-[0.06em] font-black uppercase select-none transition-all duration-300">
      KEVINDEV
    </h1>
    
    <p class="brand-subtitle mt-1 sm:mt-1.5 uppercase font-bold tracking-[0.18em] sm:tracking-[0.24em] font-mono select-none transition-all duration-300">
      ESPECIALISTA EN ASTRO, REACT &amp; AWS
    </p>
  </div>

</div>

<style>
  /* --- ESTILOS MODO OSCURO (POR DEFECTO) --- */
  .logo-ambient-glow {
    background: rgba(6, 182, 212, 0.18);
    filter: blur(95px);
  }

  .logo-svg {
    filter: drop-shadow(0 0 25px rgba(6, 182, 212, 0.45));
  }

  /* Las órbitas NUNCA deben tener relleno */
  .orbit-glow,
  .orbit-main,
  .orbit-core {
    fill: none !important;
  }

  .orbit-glow {
    stroke: #00e5ff;
    stroke-width: 5.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: url(#kd-dark-neon);
    opacity: 0.85;
  }

  .orbit-main {
    stroke: #38bdf8;
    stroke-width: 3.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .orbit-core {
    stroke: #ffffff;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.95;
  }

  .center-ignition-dot {
    fill: #ffffff;
    stroke: none;
    filter: drop-shadow(0 0 6px #00f0ff);
  }

  .icon-fill-bg {
    fill: rgba(0, 229, 255, 0.16);
  }

  .cloud-text {
    font-family: 'Outfit', 'Inter', system-ui, sans-serif;
    font-weight: 900;
    font-size: 13px;
    fill: #ffffff;
    filter: drop-shadow(0 0 6px rgba(0, 229, 255, 0.9));
  }

  .brand-title {
    font-family: 'Outfit', 'Inter', system-ui, sans-serif;
    font-size: clamp(2.4rem, 6.2vw, 4.2rem);
    line-height: 1.1;
    color: #ffffff;
    text-shadow: 
      0 0 10px #00f0ff,
      0 0 24px rgba(0, 240, 255, 0.85),
      0 0 45px rgba(2, 132, 199, 0.6);
  }

  .brand-subtitle {
    font-size: clamp(0.72rem, 1.8vw, 1.05rem);
    color: #38bdf8;
    text-shadow: 
      0 0 8px rgba(56, 189, 248, 0.9),
      0 0 18px rgba(14, 165, 233, 0.5);
  }

  /* --- ESTILOS MODO CLARO (Vibrante, Eléctrico, Ultra Visible y Nítido) --- */
  :global(.light) .logo-ambient-glow {
    background: rgba(2, 132, 199, 0.22);
    filter: blur(85px);
  }

  :global(.light) .logo-svg {
    filter: drop-shadow(0 0 20px rgba(2, 132, 199, 0.35)) drop-shadow(0 4px 12px rgba(2, 132, 199, 0.2));
  }

  :global(.light) .orbit-glow {
    stroke: #0284c7;
    stroke-width: 6.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: url(#kd-light-neon);
    opacity: 0.95;
  }

  :global(.light) .orbit-main {
    stroke: #00b4d8;
    stroke-width: 3.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global(.light) .orbit-core {
    stroke: #00f0ff;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 1;
  }

  :global(.light) .center-ignition-dot {
    fill: #0284c7;
    stroke: none;
    filter: drop-shadow(0 0 4px #00b4d8);
  }

  :global(.light) .icon-fill-bg {
    fill: rgba(2, 132, 199, 0.12);
  }

  :global(.light) .cloud-text {
    fill: #0284c7;
    filter: drop-shadow(0 0 4px rgba(6, 182, 212, 0.6));
  }

  :global(.light) .brand-title {
    color: #0284c7;
    text-shadow: 
      0 0 12px rgba(6, 182, 212, 0.75),
      0 0 28px rgba(2, 132, 199, 0.4),
      0 2px 4px rgba(2, 132, 199, 0.25);
  }

  :global(.light) .brand-subtitle {
    color: #0284c7;
    font-weight: 800;
    text-shadow: 
      0 0 8px rgba(6, 182, 212, 0.6),
      0 1px 2px rgba(2, 132, 199, 0.3);
  }
</style>
