---
import { ExperienceController } from '../../controllers/ExperienceController.js';

const timeline = ExperienceController.getTimeline();
---

<section id="experiencia-timeline" class="w-full relative py-16 md:py-24 overflow-hidden select-none">
  
  <!-- Encabezado de Sección -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 mb-16 text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-accent/30 bg-cardBg text-[10px] font-mono font-semibold text-accent mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
      SYS.TIMELINE // MILESTONES & GROWTH
    </div>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-[0.06em] text-textMain">
      EXPERIENCIA <span class="text-accent">& TRAYECTORIA</span>
    </h2>
    <p class="text-xs sm:text-sm text-textMuted font-light max-w-lg mx-auto mt-2">
      Recorrido profesional, evolución técnica e impacto en el desarrollo de plataformas digitales.
    </p>
  </div>

  <!-- Contenedor Maestro de la Línea de Tiempo -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 relative">
    
    <!-- Línea Central de Progreso Vertical -->
    <div class="absolute left-4 sm:left-1/2 top-8 bottom-8 w-[2px] bg-cardBorder sm:-translate-x-1/2 z-0">
      <div class="timeline-progress-fill w-full h-full bg-gradient-to-b from-accent via-amber-400 to-cyan-400 rounded-full shadow-[0_0_15px_rgba(245,158,11,0.7)] origin-top"></div>
    </div>

    <!-- Lista de Bloques de Años y Tarjetas -->
    <div class="flex flex-col gap-16 sm:gap-28 relative z-10">
      {timeline.map((item, index) => {
        const isEven = index % 2 === 0;
        return (
          <div class="timeline-block relative flex flex-col sm:flex-row items-center w-full">
            
            <!-- NÚMERO DE AÑO GIGANTE DE FONDO (Parallax Scroll-Driven) -->
            <div 
              class={`timeline-bg-year absolute pointer-events-none font-black text-[clamp(5rem,18vw,13rem)] tracking-tighter text-white/[0.03] font-mono select-none z-[-1] whitespace-nowrap ${
                isEven ? 'sm:left-[-5%] sm:text-left' : 'sm:right-[-5%] sm:text-right'
              }`}
              data-parallax-speed={isEven ? "30" : "20"}
            >
              {item.year}
            </div>

            <!-- Punto de Anclaje Central con Glow en la Línea de Tiempo -->
            <div class="hidden sm:flex absolute left-1/2 top-10 -translate-x-1/2 z-20 items-center justify-center">
              <div class="w-6 h-6 rounded-full bg-cardBg border-2 border-accent flex items-center justify-center shadow-[0_0_15px_rgba(245,158,11,0.6)]">
                <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
              </div>
            </div>

            <!-- Contenedor de la Tarjeta (Alternado Izquierda / Derecha) -->
            <div class={`w-full sm:w-1/2 pl-10 sm:pl-0 ${isEven ? 'sm:pr-12' : 'sm:pl-12 sm:ml-auto'}`}>
              
              <article class="timeline-role-card group relative p-6 sm:p-8 rounded-3xl border border-cardBorder bg-cardBg/80 backdrop-blur-xl shadow-[0_12px_35px_rgba(0,0,0,0.4)] transition-all duration-500 hover:border-accent/40 hover:shadow-[0_15px_45px_rgba(245,158,11,0.2)]">
                
                <!-- Borde de Glow Neón Superior -->
                <div class="absolute top-0 left-6 right-6 h-[1.5px] bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>

                <!-- Cabecera de la Tarjeta -->
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="px-3 py-1 rounded-full bg-accent/15 border border-accent/30 text-accent font-mono text-xs font-bold tracking-wider">
                    {item.period}
                  </span>
                  <span class="text-[11px] font-mono text-textMuted uppercase">
                    LOG // 0{index + 1}
                  </span>
                </div>

                <!-- Rol y Organización -->
                <h3 class="text-xl sm:text-2xl font-bold text-textMain group-hover:text-accent transition-colors">
                  {item.role}
                </h3>
                <p class="text-xs font-semibold text-accent/90 uppercase font-mono tracking-wider mt-0.5">
                  {item.company}
                </p>

                <!-- Descripción principal -->
                <p class="text-xs sm:text-sm text-textMuted font-light leading-relaxed mt-3">
                  {item.description}
                </p>

                <!-- Lista de Logros Clave -->
                <ul class="flex flex-col gap-2 mt-4 pt-4 border-t border-cardBorder/60 text-xs text-textMain/90 font-light">
                  {item.achievements.map((ach) => (
                    <li class="flex items-start gap-2">
                      <span class="text-accent mt-0.5 font-bold">✦</span>
                      <span>{ach}</span>
                    </li>
                  ))}
                </ul>

                <!-- Badges de Tecnologías -->
                <div class="flex flex-wrap gap-1.5 mt-5 pt-3 border-t border-cardBorder/40">
                  {item.tags.map((t) => (
                    <span class="interactive-tag text-[9px] font-mono font-medium px-2.5 py-0.5 rounded-full bg-background/80 border border-cardBorder text-textMuted hover:text-accent hover:border-accent/40 transition-colors">
                      #{t}
                    </span>
                  ))}
                </div>

              </article>

            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  :global(.light) .timeline-bg-year {
    color: rgba(15, 23, 42, 0.04);
  }
</style>
