---
import { ProfileController } from '../../controllers/ProfileController.js';

const heroData = ProfileController.getHeroData();
---
<section id="inicio" class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 items-center z-10">
    
    <!-- Text Content -->
    <div class="flex flex-col gap-6 animate-fade-in-up opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight leading-tight">
        Creando <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-yellow-200">
          Experiencias
        </span> <br/>
        Digitales.
      </h1>
      <p class="text-lg text-gray-400 max-w-md font-light leading-relaxed">
        {heroData.subtitle}
      </p>
      <div class="flex gap-4 mt-4">
        <a href="/proyectos" class="px-8 py-3 bg-accent text-background font-semibold rounded-full hover:scale-105 transition-transform duration-300 shadow-[0_0_20px_rgba(212,175,55,0.3)]">
          Ver Proyectos
        </a>
        <a href={`mailto:${heroData.email}`} class="px-8 py-3 border border-white/10 rounded-full hover:bg-white/5 transition-colors duration-300">
          Contactar
        </a>
      </div>
    </div>

    <!-- Image with Mirror Effect -->
    <div class="relative flex flex-col items-center justify-center animate-fade-in-up opacity-0" style="animation-delay: 0.4s; animation-fill-mode: forwards;">
      <!-- Contenedor Principal de la Imagen -->
      <div class="relative w-64 h-64 md:w-80 md:h-80 z-10">
        <!-- Puedes reemplazar esta URL por una imagen local en public/ -->
        <img 
          src={heroData.imageUrl} 
          alt="Perfil del Desarrollador" 
          class="w-full h-full object-cover rounded-2xl shadow-2xl border border-white/5 grayscale hover:grayscale-0 transition-all duration-700"
        />
      </div>

      <!-- Reflejo Especular (Mirror Effect) -->
      <div class="relative w-64 h-64 md:w-80 md:h-80 -mt-2 scale-y-[-1] opacity-60">
        <img 
          src={heroData.imageUrl} 
          alt="Reflejo" 
          class="w-full h-full object-cover rounded-2xl blur-[2px] mask-image-gradient grayscale"
        />
      </div>
    </div>

  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>
