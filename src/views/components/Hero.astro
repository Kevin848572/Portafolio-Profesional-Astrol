---
import KevinDevLogo from './KevinDevLogo.astro';
import { ProfileController } from '../../controllers/ProfileController.js';

const heroData = ProfileController.getHeroData();
---

<section id="inicio" class="relative min-h-[92vh] flex flex-col items-center justify-center pt-24 pb-12 px-4 overflow-hidden select-none">
  
  <!-- Resplandor ambiental de fondo (Neón Azul / Cian) -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[340px] h-[340px] sm:w-[600px] sm:h-[600px] md:w-[850px] md:h-[850px] rounded-full bg-cyan-500/10 blur-[120px] md:blur-[160px] pointer-events-none z-0"></div>

  <!-- Contenedor Central del Logo SVG con Neón Fluido -->
  <div class="hero-monogram-card relative z-20 flex flex-col items-center justify-center w-full max-w-4xl mx-auto transition-transform duration-500">
    
    <!-- Logo SVG Neón Fiel a la Imagen: Átomo React + Astro + AWS + KEVINDEV + Especialista -->
    <div class="w-full max-w-[340px] sm:max-w-[480px] md:max-w-[580px] lg:max-w-[640px] px-2 flex justify-center">
      <KevinDevLogo />
    </div>

    <!-- Descripción Biográfica Principal (Adaptativa, Nítida y con Contraste Óptimo) -->
    <div class="mt-4 sm:mt-6 text-center max-w-2xl px-4">
      <p class="hero-bio-desc text-sm sm:text-base md:text-lg leading-relaxed transition-colors duration-300">
        Desarrollador Web especializado en la creación de interfaces estéticas, reactivas y de alto rendimiento utilizando Astro, React y Tailwind CSS.
      </p>
    </div>

    <!-- Botones de Acción Elegantes con Efecto Glassmorphism Neón -->
    <div class="flex flex-wrap items-center justify-center gap-3.5 sm:gap-5 mt-8 z-30">
      <a 
        href="/proyectos" 
        class="hero-cta-btn px-7 py-3 rounded-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black text-xs uppercase tracking-widest hover:scale-105 hover:shadow-[0_0_28px_rgba(6,182,212,0.65)] active:scale-95 transition-all duration-300 shadow-md flex items-center gap-2"
      >
        <span>Explorar Proyectos</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
        </svg>
      </a>

      <a 
        href="/#panel-control" 
        class="hero-cta-secondary px-7 py-3 rounded-full border border-cyan-600/30 font-bold text-xs uppercase tracking-widest hover:scale-105 active:scale-95 transition-all duration-300 flex items-center gap-1.5 shadow-sm"
      >
        <span class="material-icons-outlined text-sm text-cyan-600 dark:text-cyan-400">dashboard</span>
        <span>Ver Panel &amp; Métricas</span>
      </a>
    </div>

  </div>

</section>

<style>
  .hero-bio-desc {
    color: #cbd5e1;
    font-weight: 300;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
  }

  .hero-cta-secondary {
    background: rgba(6, 12, 30, 0.65);
    color: #f8fafc;
    border-color: rgba(6, 182, 212, 0.3);
    backdrop-filter: blur(16px);
  }

  .hero-cta-secondary:hover {
    color: #67e8f9;
    border-color: rgba(6, 182, 212, 0.6);
  }

  /* Modo Claro */
  :global(.light) .hero-bio-desc {
    color: #334155;
    font-weight: 500;
    text-shadow: none;
  }

  :global(.light) .hero-cta-secondary {
    background: rgba(255, 255, 255, 0.85);
    color: #0f172a;
    border-color: rgba(2, 132, 199, 0.35);
    backdrop-filter: blur(16px);
  }

  :global(.light) .hero-cta-secondary:hover {
    color: #0284c7;
    border-color: rgba(2, 132, 199, 0.7);
  }
</style>
