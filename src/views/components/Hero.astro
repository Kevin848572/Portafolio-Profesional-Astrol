---
import { ProfileController } from '../../controllers/ProfileController.js';

const heroData = ProfileController.getHeroData();
---
<section id="inicio" class="relative min-h-[90vh] flex flex-col items-center justify-center pt-32 pb-16 overflow-hidden">
  
  <!-- Glowing Background Radial Glow behind the big PORTFOLIO text -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] md:w-[600px] md:h-[600px] rounded-full bg-accent/20 blur-[120px] pointer-events-none z-0"></div>

  <!-- Contenedor de la Foto y Efecto Espejo -->
  <div class="relative flex flex-col items-center justify-center z-10 select-none animate-fade-in">
    
    <!-- Retrato Vertical Central -->
    <div class="relative w-56 h-[320px] md:w-64 md:h-[380px] overflow-hidden rounded-2xl border border-white/10 shadow-2xl z-20 transition-all duration-700 hover:scale-[1.02]">
      <!-- Capa de brillo superior de cristal -->
      <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/5 to-white/10 pointer-events-none"></div>
      <img 
        src={heroData.imageUrl} 
        alt="Perfil del Desarrollador" 
        class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000 ease-out scale-105 hover:scale-100"
      />
    </div>

    <!-- Reflejo Especular Invertido (Mirror Effect) -->
    <div class="relative w-56 h-[320px] md:w-64 md:h-[380px] -mt-1 scale-y-[-1] opacity-30 pointer-events-none select-none z-10 blur-[1px]">
      <img 
        src={heroData.imageUrl} 
        alt="Reflejo" 
        class="w-full h-full object-cover mask-image-gradient grayscale"
      />
    </div>

    <!-- Texto Gigante Superpuesto "PORTFOLIO" con Brillo -->
    <h1 class="absolute top-[200px] md:top-[240px] text-6xl sm:text-7xl md:text-9xl font-black tracking-[0.2em] text-white/95 z-30 drop-shadow-[0_4px_30px_rgba(212,175,55,0.4)] pointer-events-none text-center pl-[0.2em] uppercase font-sans">
      PORTFOLIO
    </h1>
  </div>

  <!-- Luces decorativas de meteoros o estrellas fugaces (como en la imagen de referencia) -->
  <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="meteor-1"></div>
    <div class="meteor-2"></div>
    <div class="meteor-3"></div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.97); }
    to { opacity: 1; transform: scale(1); }
  }
  .animate-fade-in {
    animation: fadeIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Estilos para meteoros fugaces de la imagen de referencia */
  .meteor-1, .meteor-2, .meteor-3 {
    position: absolute;
    width: 2px;
    height: 60px;
    background: linear-gradient(to top, rgba(212, 175, 55, 0.4), transparent);
    transform: rotate(-35deg);
    opacity: 0.15;
  }
  .meteor-1 { top: 25%; left: 15%; height: 80px; }
  .meteor-2 { top: 45%; right: 20%; height: 50px; }
  .meteor-3 { top: 60%; left: 75%; height: 70px; }
</style>
