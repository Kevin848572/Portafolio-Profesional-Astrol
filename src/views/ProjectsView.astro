---
import Layout from './layouts/Layout.astro';
import Navbar from './components/Navbar.astro';
import { ProjectController } from '../controllers/ProjectController.js';
import { ProfileController } from '../controllers/ProfileController.js';

const projects = ProjectController.getFeaturedProjects();
const footerData = ProfileController.getFooterData();
---

<Layout title="Proyectos | Desarrollador Frontend">
  <Navbar />
  
  <main class="relative z-10 w-full pt-32 pb-24 min-h-screen">
    <!-- Radial ambient glow -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[400px] h-[400px] rounded-full bg-accent/10 blur-[100px] pointer-events-none z-0"></div>

    <section id="proyectos" class="max-w-6xl mx-auto px-6 z-10 relative reveal-on-scroll opacity-0 translate-y-10 transition-all duration-1000 ease-out">
      
      <!-- Glassmorphism Card Container -->
      <div class="w-full p-8 md:p-12 rounded-[2.5rem] border border-cardBorder backdrop-blur-md bg-cardBg/30 shadow-[0_12px_40px_rgba(0,0,0,0.4)]">
        
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-5xl font-black uppercase tracking-[0.1em] text-textMain mb-4">
            PROYECTOS <span class="text-accent">DESTACADOS</span>
          </h2>
          <p class="text-sm text-textMuted font-light max-w-lg mx-auto">
            Explora una selección de mis trabajos más recientes construidos con tecnologías de alto rendimiento y estética impecable.
          </p>
        </div>
        
        <!-- Grid of Project Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {projects.map((project, idx) => (
            <article class="group relative rounded-2xl border border-cardBorder bg-background/50 p-6 flex flex-col justify-between h-72 overflow-hidden transition-all duration-500 hover:border-accent/40">
              <div class="flex flex-col gap-4 z-10">
                <span class="text-[10px] uppercase font-bold tracking-widest text-accent">0{idx + 1} / Project</span>
                <h3 class="text-xl font-bold text-textMain group-hover:text-accent transition-colors">{project.title}</h3>
                <p class="text-sm text-textMuted font-light leading-relaxed">{project.desc}</p>
              </div>
              
              <div class="flex gap-2 flex-wrap z-10 mt-6">
                {project.tags.map(tag => (
                  <span class="text-[10px] font-semibold px-2.5 py-0.5 bg-cardBg border border-cardBorder rounded-full text-textMain">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Glow border and bottom glow -->
              <div class="absolute inset-0 bg-gradient-to-t from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0"></div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- Floating Star Sparkle -->
    <div class="fixed bottom-8 right-8 z-30 pointer-events-none select-none animate-pulse">
      <svg class="w-10 h-10 md:w-14 md:h-14 text-accent drop-shadow-[0_0_15px_rgba(212,175,55,0.6)]" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z" />
      </svg>
    </div>
  </main>

  <footer class="border-t border-cardBorder py-12 text-center text-footerText font-light text-sm relative z-10 bg-background/80 backdrop-blur-sm">
    <p>&copy; {footerData.year} {footerData.copyText}</p>
  </footer>
</Layout>

<script>
  const setupProjectsObserver = () => {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('opacity-0', 'translate-y-10');
          entry.target.classList.add('opacity-100', 'translate-y-0');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const elements = document.querySelectorAll('.reveal-on-scroll');
    elements.forEach(el => observer.observe(el));
  };

  document.addEventListener('DOMContentLoaded', setupProjectsObserver);
</script>
