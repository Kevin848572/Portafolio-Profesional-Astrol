---
import Layout from './layouts/Layout.astro';
import Navbar from './components/Navbar.astro';
import Hero from './components/Hero.astro';
import DeveloperDashboard from './components/DeveloperDashboard.astro';
import ProjectShowcase3D from './components/ProjectShowcase3D.astro';
import ExperienceTimeline from './components/ExperienceTimeline.astro';
import { ProjectController } from '../controllers/ProjectController.js';
import { ProfileController } from '../controllers/ProfileController.js';

const projects = ProjectController.getFeaturedProjects();
const footerData = ProfileController.getFooterData();
const heroData = ProfileController.getHeroData();

const mainTech = [
  { name: "Astro", label: "Arquitectura de Islas & SSG", icon: "✦", color: "text-amber-400" },
  { name: "React", label: "Componentes Reactivos & Hooks", icon: "⚛", color: "text-cyan-400" },
  { name: "Tailwind CSS", label: "Diseño UI & Glassmorphism", icon: "≋", color: "text-teal-400" },
  { name: "TypeScript", label: "Tipado Estricto & Robustez", icon: "TS", color: "text-blue-400" },
  { name: "GSAP & ScrollTrigger", label: "Animaciones Cinemáticas", icon: "⚡", color: "text-violet-400" },
  { name: "Lenis", label: "Smooth Scroll Ultra Fluido", icon: "◎", color: "text-rose-400" }
];
---

<Layout title="Kevin Pérez | Desarrollador Frontend & UI Specialist">
  <Navbar />
  
  <main class="relative z-10 w-full overflow-hidden">
    <!-- 1. Hero Section con Kinetic Typography y Photo Reveal -->
    <Hero />

    <!-- 2. Panel de Control y Analítica de Desarrollo (Inspirado en Taller Mecánico) -->
    <DeveloperDashboard />

    <!-- 3. Sección Principal: 3D Project Showcase + Core Stack -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-12 z-20 relative">
      
      <!-- Contenedor Maestro Glassmorphic -->
      <div class="w-full p-5 sm:p-8 md:p-12 rounded-3xl md:rounded-[2.5rem] glass-panel shadow-[0_15px_45px_rgba(0,0,0,0.5)]">
        
        <!-- 3D Project Showcase: Trabajos Destacados con Tilt y Glow -->
        <div class="mb-16">
          <ProjectShowcase3D projects={projects} />
        </div>

        <!-- Columna de Stack Tecnológico y Resumen -->
        <div class="pt-8 border-t border-cardBorder">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="w-2 h-2 rounded-full bg-accent"></span>
                <span class="text-[10px] font-mono uppercase tracking-widest text-accent font-bold">CORE ARCHITECTURE</span>
              </div>
              <h2 class="text-xl sm:text-2xl md:text-3xl font-bold uppercase tracking-[0.06em] text-textMain">
                STACK DE DESARROLLO
              </h2>
            </div>
            <a 
              href="/habilidades" 
              class="magnetic-btn text-xs uppercase tracking-wider font-bold text-textMuted hover:text-accent transition-colors flex items-center gap-1.5 group"
            >
              <span>Ver Habilidades Completas</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>

          <!-- Cuadrícula de Tecnologías Principales -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {mainTech.map(tech => (
              <div class="flex items-center gap-4 p-4 rounded-2xl bg-background/50 border border-cardBorder hover:border-accent/40 hover:bg-cardBg transition-all duration-300 group">
                <div class="w-12 h-12 rounded-xl bg-cardBg border border-cardBorder flex items-center justify-center text-lg font-mono font-bold shadow-inner transition-transform group-hover:scale-110 shrink-0">
                  <span class={tech.color}>{tech.icon}</span>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-textMain group-hover:text-accent transition-colors">{tech.name}</h3>
                  <span class="text-[11px] text-textMuted font-light">{tech.label}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- 4. Línea de Tiempo / Experiencia con Scroll-Driven Animation y Parallax -->
    <ExperienceTimeline />

  </main>

  <!-- Footer Glassmorphism -->
  <footer class="border-t border-cardBorder py-12 text-center text-footerText font-light text-sm relative z-10 bg-background/80 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="font-mono text-xs font-bold text-textMain">KEVIN PÉREZ // DEV PORTFOLIO</span>
      </div>
      <p class="text-xs">&copy; {footerData.year} {footerData.copyText}</p>
      <div class="flex items-center gap-4 text-xs font-mono text-textMuted">
        <a href="https://github.com/Kevin848572" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
        <a href="https://www.linkedin.com/in/kevin-josé-pérez-martínez-4a7bbb23b" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">LinkedIn</a>
        <a href="https://www.instagram.com/kevin_perez52" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">Instagram</a>
      </div>
    </div>
  </footer>
</Layout>
